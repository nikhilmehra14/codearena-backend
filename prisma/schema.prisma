// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
  github
}

enum Platform {
  leetcode
  codeforces
  codechef
  atcoder
  hackerrank
  hackerearth
}

enum ContestStatus {
  upcoming
  ongoing
  completed
}

model User {
  id                   String            @id @default(uuid())
  username             String            @unique @db.VarChar(50)
  email                String            @unique @db.VarChar(100)
  password             String?           @db.VarChar(255)
  fullName             String?           @db.VarChar(100)
  bio                  String?           @db.Text
  avatar               String?           @db.VarChar(500)
  phoneNumber          String?           @db.VarChar(20)
  country              String?           @db.VarChar(100)
  authProvider         AuthProvider      @default(local)
  authProviderId       String?           @db.VarChar(100)
  isVerified           Boolean           @default(false)
  notificationEnabled  Boolean           @default(true)
  notificationTime     Int               @default(30) // Minutes before contest
  notifyViaPush        Boolean           @default(true)
  notifyViaWhatsApp    Boolean           @default(false)
  notifyViaEmail       Boolean           @default(false)
  darkMode             Boolean           @default(false)
  timezone             String            @default("UTC") @db.VarChar(50)
  preferredPlatforms   Json              @default("[]") // Array of platform names user wants to see
  fcmToken             String?           @db.Text
  lastLogin            DateTime?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  reminders            Reminder[]
  linkedPlatforms      LinkedPlatform[]
  stats                UserStats[]
  refreshTokens        RefreshToken[]
  loginActivities      LoginActivity[]

  @@index([email])
  @@index([username])
  @@index([phoneNumber])
  @@index([authProvider, authProviderId])
  @@map("users")
}

model Contest {
  id              String         @id @default(uuid())
  externalId      String         @db.VarChar(100)
  name            String         @db.VarChar(255)
  platform        Platform
  url             String         @db.VarChar(500)
  startTime       DateTime
  endTime         DateTime
  duration        Int            // Duration in seconds
  status          ContestStatus  @default(upcoming)
  platformLogo    String?        @db.VarChar(500)
  description     String?        @db.Text
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reminders       Reminder[]

  @@unique([externalId, platform])
  @@index([platform])
  @@index([startTime])
  @@index([status])
  @@index([status, endTime])  // Compound index for status updates
  @@index([platform, status, startTime])  // Compound index for platform-specific queries
  @@map("contests")
}

model Reminder {
  id                  String    @id @default(uuid())
  userId              String
  contestId           String
  reminderTime        Int       @default(30) // Minutes before contest
  notificationSent    Boolean   @default(false)
  notificationSentAt  DateTime?
  isActive            Boolean   @default(true)
  scheduledTime       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest             Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId])
  @@index([userId])
  @@index([contestId])
  @@index([notificationSent])
  @@index([scheduledTime])
  @@index([userId, isActive])  // Compound index for user's active reminders
  @@index([notificationSent, isActive, scheduledTime])  // Compound index for pending notifications
  @@map("reminders")
}

model LinkedPlatform {
  id                String    @id @default(uuid())
  userId            String
  platform          Platform
  platformUsername  String    @db.VarChar(100)
  isVerified        Boolean   @default(false)
  lastSynced        DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@map("linked_platforms")
}

model UserStats {
  id                    String    @id @default(uuid())
  userId                String
  platform              Platform
  rating                Int?
  maxRating             Int?
  globalRank            Int?
  countryRank           Int?
  problemsSolved        Int       @default(0)
  contestsParticipated  Int       @default(0)
  badges                Json      @default("[]")
  statsData             Json      @default("{}")
  lastFetched           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@map("user_stats")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique @db.VarChar(500)
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  deviceInfo  String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginActivity {
  id          String    @id @default(uuid())
  userId      String
  ipAddress   String    @db.VarChar(45) // IPv4 (15) or IPv6 (45)
  userAgent   String?   @db.VarChar(500)
  deviceInfo  String?   @db.VarChar(255)
  browser     String?   @db.VarChar(100)
  os          String?   @db.VarChar(100)
  loginAt     DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("login_activities")
}
