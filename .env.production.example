# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.production and update all values
# NEVER commit .env.production to version control

# Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Database Configuration (Prisma)
# Use your production database URL
# Example for managed PostgreSQL (AWS RDS, DigitalOcean, etc.):
# postgresql://username:password@your-db-host:5432/codearena?schema=public&sslmode=require
DATABASE_URL=postgresql://username:password@your-production-db-host:5432/codearena?schema=public&sslmode=require

# Redis Configuration
# Use your production Redis instance
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
CACHE_TTL=3600

# JWT Configuration
# CRITICAL: Generate strong, unique secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_IN_PRODUCTION
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_STRONG_SECRET
JWT_REFRESH_EXPIRE=30d

# OAuth Configuration
# Update callback URLs to your production domain
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/github/callback

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json

# External API Keys
# Clist.by API (Recommended)
CLIST_API_KEY=your_clist_api_key_here

# Individual Platform APIs (Optional)
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
LEETCODE_SESSION=
CODECHEF_API_KEY=

# Rate Limiting
# Adjust based on your expected traffic
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
# IMPORTANT: Set to your actual frontend domain(s)
# Examples:
# - Single domain: https://yourdomain.com
# - Multiple domains: https://yourdomain.com,https://app.yourdomain.com,https://mobile.yourdomain.com
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# Cron Job Configuration
CONTEST_FETCH_CRON=0 */1 * * *
NOTIFICATION_CHECK_CRON=*/5 * * * *

# Logging
LOG_LEVEL=warn
LOG_FILE_PATH=./logs/app.log

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Application URLs
# REQUIRED: Set these to your actual production URLs
# Examples:
# - Frontend: https://yourdomain.com or https://app.yourdomain.com
# - Backend: https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# ========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ========================================
# Before deploying to production, ensure:
# ✅ All placeholder values are replaced with actual values
# ✅ Strong JWT secrets are generated (not default values)
# ✅ Database URL points to production database
# ✅ CORS_ORIGIN contains only your production domains
# ✅ FRONTEND_URL and BACKEND_URL are set to production URLs
# ✅ OAuth callback URLs match your production domain
# ✅ Redis is configured and accessible
# ✅ SSL certificates are configured (for HTTPS)
# ✅ Firewall rules allow only necessary ports
# ✅ Database connection uses SSL (sslmode=require)
# ✅ Log level is set to 'warn' or 'error' for production
# ✅ This file is NOT committed to version control
