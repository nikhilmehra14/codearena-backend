# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (Prisma)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/codearena?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRE=30d

# OAuth Configuration
# IMPORTANT: Update these URLs based on your deployment
# For development: http://localhost:5000/api/v1/auth/google/callback
# For production: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=${BACKEND_URL}/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=${BACKEND_URL}/api/v1/auth/github/callback

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json

# External API Keys
# Clist.by API (Recommended - aggregates all contest platforms)
# Get your API key from: https://clist.by/api/v4/doc/
CLIST_API_KEY=your_clist_api_key_here

# Individual Platform APIs (Fallback - used if Clist is not configured)
# Note: Contest fetching works without these as we use public APIs
# These are only needed for advanced stats fetching
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
LEETCODE_SESSION=
CODECHEF_API_KEY=

# External API URLs (Optional - only change if using proxies or mirrors)
# Default values are the official public API endpoints
# KONTESTS_API_URL=https://kontests.net/api/v1/all
# CLIST_API_URL=https://clist.by/api/v4
# CODEFORCES_API_URL=https://codeforces.com/api
# LEETCODE_API_URL=https://leetcode.com/graphql
# CODECHEF_API_URL=https://www.codechef.com/api
# ATCODER_API_URL=https://atcoder.jp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:19006
# Production: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Cron Job Configuration
CONTEST_FETCH_CRON=0 */1 * * *
NOTIFICATION_CHECK_CRON=*/5 * * * *

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_RETENTION_DAYS=7

# Email Configuration (SMTP for OTP verification)
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@codearena.com
EMAIL_FROM_NAME=CodeArena

# WhatsApp Configuration (via Twilio)
# Get credentials from: https://www.twilio.com/console
# For testing: Use Twilio Sandbox WhatsApp number
# For production: Request WhatsApp Business API approval
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Application URLs
# REQUIRED: Must be set for the application to work properly
# Development examples below - CHANGE for production
FRONTEND_URL=http://localhost:19006
BACKEND_URL=http://localhost:5000
